{
  "name": "laziness-start",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "bun run i18n:extract && vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "check:fix": "biome check --write",
    "format": "biome format",
    "lint": "biome lint",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui extract --clean && lingui compile --strict",
    "verify": "bun run typecheck && bun run check && bun run i18n:check && bun run build"
  },
  "dependencies": {
    "@lingui/core": "^6.10.0",
    "@lingui/format-json": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "@lingui/vite-plugin": "^6.10.0",
    "@sourceking/tanstack-lingui": "^0.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@lingui/cli": "^6.10.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
